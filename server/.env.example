# 앱 설정의 '서버 토큰'에 같은 값을 넣으세요. 길고 무작위로: openssl rand -hex 32
AGENT_TOKEN=

# anthropic | openai | gemini | grok | openrouter
# 가족 검증처럼 비용 없이 돌리려면 gemini (무료 등급, 일일 한도 있음) 를 권한다:
#   LLM_PROVIDER=gemini  GEMINI_API_KEY=...  DAILY_REQUEST_LIMIT=200
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
# 'not scoped to a workspace' 오류가 날 때만: Console 의 워크스페이스 ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Grok (xAI): https://console.x.ai
XAI_API_KEY=
# OpenRouter: https://openrouter.ai/keys — 기본 모델 openrouter/free 는 무료 모델로 자동 연결
OPENROUTER_API_KEY=

MAX_STEPS=60

# LLM 호출 수 한도 (0 = 무제한). 넘으면 앱에 "오늘은 여기까지예요" 가 뜬다.
DAILY_REQUEST_LIMIT=0
MONTHLY_REQUEST_LIMIT=0

# 웹 앱이 이 서버를 부를 출처. 쉼표 구분. 예: https://ai-agent.vercel.app,http://localhost:5173
CORS_ORIGINS=*
